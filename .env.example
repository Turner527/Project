# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Ключ авторизации из личного кабинета GigaChat API (раздел «Настройки API» -> «Получить ключ»)
GIGACHAT_CREDENTIALS=
# Версия API: GIGACHAT_API_PERS (физлица), GIGACHAT_API_B2B или GIGACHAT_API_CORP (юрлица)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Путь к корневому сертификату Минцифры (PEM). Проверка SSL всегда включена.
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.pem
# Модель с поддержкой вызова функций
GIGACHAT_MODEL=GigaChat-2-Pro

# Необязательно: gigachat | stub (по умолчанию gigachat, если задан ключ, иначе stub)
# LLM_BACKEND=
# Необязательно: mcp | direct (по умолчанию mcp)
# TOOLS_BACKEND=
# Необязательно: путь к SQLite-логу
# LOG_DB_PATH=logs/pilot.db
